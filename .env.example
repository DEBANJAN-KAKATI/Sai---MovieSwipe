# Copy to .env (project root or backend/) — every value is optional.

# Default: SQLite file at backend/movieswipe.db. For Postgres: pip install -e "backend[postgres]" and use
# DATABASE_URL=postgresql+psycopg://movieswipe:movieswipe@localhost:5432/movieswipe
DATABASE_URL=

# TMDB v3 API key or v4 read-access token. Enables real posters/trailers, live India watch providers,
# catalog growth (scripts/sync_tmdb.py) and on-demand import from search.
TMDB_API_KEY=

# Generated and stored in backend/.jwt_secret when empty.
JWT_SECRET=

APP_REGION_DEFAULT=IN

# hash (default, no downloads) | sbert (pip install -e "backend[sbert]")
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Recommender & session tuning
TASTE_HALF_LIFE_DAYS=14
UNDECIDED_COOLDOWN_HOURS=72
REJECTED_COOLDOWN_DAYS=60
SESSION_TTL_MINUTES=120

# Enables GET /api/admin/metrics with header X-Admin-Token
ADMIN_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost
